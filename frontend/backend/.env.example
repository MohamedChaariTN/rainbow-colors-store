# ======================================================
# NEON POSTGRESQL
# Use the pooled Neon connection string at runtime.
# Do not commit real credentials.
# ======================================================
DATABASE_URL="postgresql://USER:PASSWORD@POOLED-HOST/DATABASE?sslmode=require"

# Direct (unpooled) Neon connection.
# Reserved for future approved migrations. The current
# Prisma schema does not read this variable yet.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=require"

# ======================================================
# APPLICATION
# ======================================================
JWT_SECRET="change-this-local-secret"
# Exact frontend origin(s), comma-separated. Required in production.
FRONTEND_URL=""
NODE_ENV="development"
PORT=3000

# ======================================================
# EMAIL
# ======================================================
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL=""
